# ============================================================
#  BETA BOT HUB - environment variables
#  Heroku/Railway/Render: add these in "Variables" / "Config Vars"
#  VPS: copy this file to .env and fill it
#  NEVER upload your real .env to GitHub (it is in .gitignore)
# ============================================================

# ===== Telegram (my.telegram.org + @BotFather) =====
API_ID=12345678
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_from_botfather
ADMIN_IDS=123456789

# ===== TeraBox download API (KEEP SECRET - users never see it) =====
TERABOX_API_URL=https://terabox-api.ftmdeveloperz.workers.dev/api?url=
# optional backups, comma separated
TERABOX_BACKUP_APIS=

# ===== Web server for "Watch Now" / "Download Now" buttons =====
# Your PUBLIC address (no slash at the end). Railway/Render/Heroku can auto-detect,
# on VPS set it: https://bot.yourdomain.com  or  http://YOUR_VPS_IP:8080
BASE_URL=
PORT=8080
# random text, any value (keeps links stable after restart)
WEB_SECRET=change_me_to_random_text
# stream = API + CDN fully hidden (recommended) | redirect = saves bandwidth
PROXY_MODE=stream
# how long Watch/Download links stay alive
WEB_LINK_TTL_MINUTES=360

# ===== Size rules =====
# video sent in chat up to this size (Telegram max is 2000)
MAX_SEND_MB=2000
# above this: video NOT sent, warning + Watch Now / Download Now buttons
MAX_DOWNLOAD_GB=2.99
# max file users can send for PlayMast upload (Telegram max is 2000)
MAX_UPLOAD_MB=2000
MAX_PARALLEL_JOBS=4

# ===== Branding =====
BRAND_NAME=Beta Bot Hub
BRAND_TAGLINE=TeraBox Video Downloader & Cloud Uploader
WATERMARK_TEXT=BETA BOT HUB
# live typing effect on /start (true/false)
WELCOME_TYPING=true
# banner: leave empty to use assets/banner.png, or put an image URL / file_id
START_PIC=

# ===== Must Join (bot must be ADMIN in both) =====
CHANNEL_USERNAME=@betabot_hub
GROUP_USERNAME=@betabot_support
UPDATES_CHANNEL=@betabot_hub

# ===== Timers (minutes) =====
QR_EXPIRY_MINUTES=10
MEDIA_AUTO_DELETE_MINUTES=5

# ===== Database (empty = SQLite file) =====
MONGODB_URI=
DB_NAME=betabothub

# ===== Auto Payment Gateway =====
PAYMENT_API_URL=https://betapaymentgateway.up.railway.app
PAYMENT_API_KEY=
PAYMENT_POLL_SECONDS=8

# ===== 3 Logger Groups (bot must be admin; IDs start with -100) =====
LOG_GROUP_ID=
PAYMENT_LOG_GROUP_ID=
DATA_LOG_GROUP_ID=

# ===== PlayMast Uploader (used for uploads) =====
PLAYMAST_API_URL=https://playmast-studio-bot.loca.lt
# Bearer token from PlayMast (OR set email + password below)
PLAYMAST_API_TOKEN=
PLAYMAST_EMAIL=
PLAYMAST_PASSWORD=
